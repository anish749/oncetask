# Google Cloud project containing the Firestore database with the `onceTasks` collection.
GOOGLE_CLOUD_PROJECT=my-project-id

# Path to the YAML file defining outbound links shown in the detail pane and
# inline in the list rows. See links.example.yaml for the format.
# Unset = no links rendered, mutations still work.
ONCETASK_LINKS_CONFIG=./links.yaml

# For local dev, run `gcloud auth application-default login` so the
# Firestore SDK picks up your credentials via ADC. In production, attach
# a service account via workload identity or GOOGLE_APPLICATION_CREDENTIALS.
